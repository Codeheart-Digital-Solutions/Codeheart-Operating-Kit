{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Codeheart-Digital-Solutions/Codeheart-Operating-Kit/schemas/plan-migration-ledger-v1.schema.json",
  "title": "Codeheart Plan Metadata Migration Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "inventory_revision", "reviewed_at", "records"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "repository_id": { "$ref": "#/$defs/identifier" },
    "inventory_revision": { "$ref": "#/$defs/commit" },
    "reviewed_at": { "$ref": "#/$defs/timestamp" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_revision",
          "source_sha256",
          "decision",
          "confidence",
          "ambiguity",
          "evidence",
          "legacy_aliases",
          "conflicts",
          "deferred",
          "branch_owner"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "source_revision": { "$ref": "#/$defs/commit" },
          "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "purpose", "first_cataloged", "catalog_metadata_updated"],
            "properties": {
              "id": { "$ref": "#/$defs/planId" },
              "kind": { "type": "string", "enum": ["discovery", "implementation", "family"] },
              "purpose": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
              "first_cataloged": { "$ref": "#/$defs/timestamp" },
              "catalog_metadata_updated": { "$ref": "#/$defs/timestamp" },
              "family": { "$ref": "#/$defs/planId" },
              "products": { "$ref": "#/$defs/identifiers" },
              "capabilities": { "$ref": "#/$defs/identifiers" },
              "strategic_themes": { "$ref": "#/$defs/identifiers" },
              "relations": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "target"],
                  "properties": {
                    "kind": { "type": "string", "enum": ["parent", "child", "supersedes", "superseded-by", "depends-on", "blocks", "related"] },
                    "target": { "$ref": "#/$defs/planId" }
                  }
                }
              }
            }
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "ambiguity": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "legacy_aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "conflicts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "deferred": { "type": "boolean" },
          "deferral_reason": { "type": "string", "minLength": 1 },
          "branch_owner": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "deferred": { "const": true } },
              "required": ["deferred"]
            },
            "then": { "required": ["deferral_reason"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
      }
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.(?:discovery|implementation|family)\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
