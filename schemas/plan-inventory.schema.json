{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Codeheart-Digital-Solutions/Codeheart-Operating-Kit/schemas/plan-inventory.schema.json",
  "title": "Codeheart Plan Inventory v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "catalog_mode",
    "source_revision",
    "evidence_revision",
    "generated_at",
    "records",
    "unpaired_legacy_evidence",
    "coverage",
    "problems",
    "discovery_version",
    "configured_discovery_version",
    "configured_catalog_mode",
    "target_catalog_mode",
    "policy_digest",
    "candidate_set_digest",
    "target_config_precondition_sha256",
    "complete",
    "mixed_coverage_complete",
    "canonical_ready",
    "candidates",
    "branch_evidence"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "repository_id": { "$ref": "#/$defs/identifier" },
    "catalog_mode": { "$ref": "#/$defs/catalogMode" },
    "source_revision": { "$ref": "#/$defs/commit" },
    "evidence_revision": { "$ref": "#/$defs/commit" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/inventoryRecord" }
    },
    "unpaired_legacy_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/legacyEntry" }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "problems": {
      "type": "array",
      "items": { "$ref": "#/$defs/problem" }
    },
    "discovery_version": { "type": "integer", "const": 2 },
    "configured_discovery_version": { "type": "integer", "enum": [1, 2] },
    "configured_catalog_mode": { "$ref": "#/$defs/catalogMode" },
    "target_catalog_mode": { "type": "string", "enum": ["mixed", "canonical"] },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "candidate_set_digest": { "$ref": "#/$defs/digest" },
    "target_config_precondition_sha256": { "$ref": "#/$defs/digest" },
    "complete": { "type": "boolean" },
    "mixed_coverage_complete": { "type": "boolean" },
    "canonical_ready": { "type": "boolean" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "branch_evidence": { "$ref": "#/$defs/branchEvidence" },
    "preview_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "preview_problems": {
      "type": "array",
      "items": { "$ref": "#/$defs/problem" }
    },
    "preview_valid": { "type": "boolean" },
    "remote_overlays": {
      "type": "array",
      "items": { "$ref": "#/$defs/remoteOverlay" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.(?:discovery|implementation|family)\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "publicIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "objectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "legacyDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$"
    },
    "path": { "type": "string", "minLength": 1, "pattern": "^[^\\\\\\r\\n]+$" },
    "catalogMode": { "type": "string", "enum": ["legacy", "mixed", "canonical"] },
    "gitMode": { "type": "string", "enum": ["100644", "100755", "120000", "160000"] },
    "candidateGitMode": { "type": "string", "enum": ["100644", "100755"] },
    "evidenceScope": { "type": "string", "enum": ["local", "remote-aware"] },
    "logicalRef": {
      "type": "string",
      "pattern": "^(?:local:refs/heads/|tracking:[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?:refs/heads/|remote:[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?:refs/heads/)[^\\r\\n]+$"
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["parent", "child", "supersedes", "superseded-by", "depends-on", "blocks", "related"]
        },
        "target": { "$ref": "#/$defs/planId" }
      }
    },
    "legacyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "canonical_docs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "lifecycle": { "type": "string", "enum": ["draft", "active", "completed", "superseded", "archived"] },
        "owner": { "type": "string", "minLength": 1 },
        "canonical_docs": {
          "type": "array",
          "items": { "$ref": "#/$defs/path" }
        },
        "created": { "$ref": "#/$defs/legacyDate" },
        "last_updated": { "$ref": "#/$defs/legacyDate" },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "gitBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "object_id"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "mode": { "type": "string", "enum": ["100644", "100755", "120000", "160000"] },
        "object_id": {
          "oneOf": [
            { "$ref": "#/$defs/objectId" },
            { "const": "" }
          ]
        },
        "revision": { "$ref": "#/$defs/commit" },
        "content_sha256": { "$ref": "#/$defs/digest" },
        "stage": { "type": "integer", "minimum": 0, "maximum": 3 },
        "preview": { "type": "boolean" }
      }
    },
    "candidateProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "ownership", "policy_digest", "source"],
      "properties": {
        "signal": { "type": "string", "enum": ["filename", "metadata", "filename+metadata"] },
        "ownership": { "type": "string", "enum": ["owned", "excluded", "prospective-blocked", "hard-unowned"] },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "source": { "$ref": "#/$defs/gitBlob" },
        "exclusion_root": { "$ref": "#/$defs/path" },
        "boundary": { "$ref": "#/$defs/path" },
        "ambiguous_under": { "$ref": "#/$defs/path" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "signal", "ownership", "provenance"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "expected_kind": { "type": "string", "enum": ["discovery", "implementation", "family"] },
        "family_qualified": { "type": "boolean" },
        "signal": { "type": "string", "enum": ["filename", "metadata", "filename+metadata"] },
        "ownership": { "type": "string", "enum": ["owned", "excluded", "prospective-blocked", "hard-unowned"] },
        "provenance": { "$ref": "#/$defs/candidateProvenance" }
      }
    },
    "reviewIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_scope", "repository_id", "logical_ref", "candidate_path"],
      "properties": {
        "evidence_scope": { "$ref": "#/$defs/evidenceScope" },
        "repository_id": { "$ref": "#/$defs/identifier" },
        "logical_ref": {
          "$ref": "#/$defs/logicalRef"
        },
        "candidate_path": { "$ref": "#/$defs/path" }
      }
    },
    "pathState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "absent" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "mode", "object_id", "sha256"],
          "properties": {
            "state": { "const": "present" },
            "mode": { "$ref": "#/$defs/gitMode" },
            "object_id": { "$ref": "#/$defs/objectId" },
            "sha256": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "pathTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "before", "after"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "before": { "$ref": "#/$defs/pathState" },
        "after": { "$ref": "#/$defs/pathState" }
      }
    },
    "presentPathState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "mode", "object_id", "sha256"],
      "properties": {
        "state": { "const": "present" },
        "mode": { "$ref": "#/$defs/candidateGitMode" },
        "object_id": { "$ref": "#/$defs/objectId" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "sameContentProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_path_state", "ref_path_state"],
      "properties": {
        "kind": { "const": "same-content-v1" },
        "target_path_state": { "$ref": "#/$defs/presentPathState" },
        "ref_path_state": { "$ref": "#/$defs/presentPathState" }
      }
    },
    "incorporatedHistoryProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "transition_digest",
        "stable_patch_id",
        "incorporated_parent",
        "incorporated_commit",
        "incorporated_transition_digest",
        "incorporated_stable_patch_id"
      ],
      "properties": {
        "kind": { "const": "incorporated-history-v1" },
        "transition_digest": { "$ref": "#/$defs/digest" },
        "stable_patch_id": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "incorporated_parent": { "$ref": "#/$defs/commit" },
        "incorporated_commit": { "$ref": "#/$defs/commit" },
        "incorporated_transition_digest": { "$ref": "#/$defs/digest" },
        "incorporated_stable_patch_id": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
      }
    },
    "pathAttributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "diff", "text", "working_tree_encoding", "binary"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "diff": { "type": "string" },
        "text": { "type": "string" },
        "working_tree_encoding": { "type": "string" },
        "binary": { "type": "string" }
      }
    },
    "attributeFileState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "state": { "$ref": "#/$defs/pathState" }
      }
    },
    "attributeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "path_attributes", "attribute_files", "digest"],
      "properties": {
        "revision": { "$ref": "#/$defs/commit" },
        "path_attributes": { "type": "array", "items": { "$ref": "#/$defs/pathAttributes" } },
        "attribute_files": { "type": "array", "items": { "$ref": "#/$defs/attributeFileState" } },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "branchEvidenceBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
        "path": { "$ref": "#/$defs/path" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "branchCandidateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "identity",
        "evidence_revision",
        "policy_digest",
        "candidate_set_digest",
        "proposed_disposition",
        "digest"
      ],
      "properties": {
        "algorithm": { "const": "git-candidate-proof-v1" },
        "git_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
        "identity": { "$ref": "#/$defs/reviewIdentity" },
        "evidence_revision": { "$ref": "#/$defs/commit" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "candidate_set_digest": { "$ref": "#/$defs/digest" },
        "proposed_disposition": {
          "type": "string",
          "enum": [
            "same-content-non-owner",
            "incorporated-history-non-owner",
            "deferred-active-owner",
            "active-owner",
            "blocking"
          ]
        },
        "ref_tip": { "$ref": "#/$defs/commit" },
        "merge_base": { "$ref": "#/$defs/commit" },
        "path_transitions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pathTransition" }
        },
        "proof": {
          "oneOf": [
            { "$ref": "#/$defs/sameContentProof" },
            { "$ref": "#/$defs/incorporatedHistoryProof" }
          ]
        },
        "owner_tip_candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "mode", "object_id", "sha256", "lifecycle"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "mode": { "$ref": "#/$defs/candidateGitMode" },
            "object_id": { "$ref": "#/$defs/objectId" },
            "sha256": { "$ref": "#/$defs/digest" },
            "lifecycle": { "const": "active" }
          }
        },
        "attribute_snapshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/attributeSnapshot" }
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/branchEvidenceBlocker" }
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "inventoryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "title",
        "lifecycle",
        "source_revision",
        "source_sha256",
        "metadata_coverage",
        "parse_status",
        "problem_codes",
        "legacy_evidence",
        "legacy_ambiguous",
        "dirty_overlap",
        "signal",
        "ownership",
        "provenance",
        "authoritative",
        "branch_touch_candidates"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "kind": { "type": "string", "enum": ["discovery", "implementation", "family"] },
        "title": { "type": "string" },
        "lifecycle": { "type": "string", "enum": ["", "draft", "active", "completed", "superseded", "archived"] },
        "source_revision": {
          "oneOf": [
            { "$ref": "#/$defs/commit" },
            { "const": "" }
          ]
        },
        "source_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "const": "" }
          ]
        },
        "metadata_coverage": {
          "type": "string",
          "enum": ["canonical", "legacy", "preview", "invalid", "unsafe", "unreadable", "excluded", "prospective-blocked", "hard-unowned"]
        },
        "parse_status": { "type": "string", "minLength": 1 },
        "problem_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "plan_id": { "$ref": "#/$defs/planId" },
        "legacy_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/legacyEntry" }
        },
        "legacy_ambiguous": { "type": "boolean" },
        "dirty_overlap": { "type": "boolean" },
        "signal": { "type": "string", "enum": ["filename", "metadata", "filename+metadata"] },
        "ownership": { "type": "string", "enum": ["owned", "excluded", "prospective-blocked", "hard-unowned"] },
        "provenance": { "$ref": "#/$defs/candidateProvenance" },
        "authoritative": { "type": "boolean" },
        "preview": { "type": "boolean" },
        "branch_touch_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/branchCandidateEvidence" }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_records",
        "canonical_metadata",
        "legacy_records",
        "invalid_records",
        "unreadable_records",
        "unsafe_records",
        "unpaired_legacy_evidence",
        "branch_touch_candidates",
        "blocking_branch_touches",
        "dirty_overlaps",
        "candidates",
        "included_candidates",
        "excluded_candidates",
        "blocked_candidates",
        "unowned_candidates"
      ],
      "properties": {
        "formal_records": { "type": "integer", "minimum": 0 },
        "canonical_metadata": { "type": "integer", "minimum": 0 },
        "legacy_records": { "type": "integer", "minimum": 0 },
        "invalid_records": { "type": "integer", "minimum": 0 },
        "unreadable_records": { "type": "integer", "minimum": 0 },
        "unsafe_records": { "type": "integer", "minimum": 0 },
        "unpaired_legacy_evidence": { "type": "integer", "minimum": 0 },
        "branch_touch_candidates": { "type": "integer", "minimum": 0 },
        "blocking_branch_touches": { "type": "integer", "minimum": 0 },
        "dirty_overlaps": { "type": "integer", "minimum": 0 },
        "candidates": { "type": "integer", "minimum": 0 },
        "included_candidates": { "type": "integer", "minimum": 0 },
        "excluded_candidates": { "type": "integer", "minimum": 0 },
        "blocked_candidates": { "type": "integer", "minimum": 0 },
        "unowned_candidates": { "type": "integer", "minimum": 0 },
        "preview_candidates": { "type": "integer", "minimum": 0 }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
        "path": { "$ref": "#/$defs/path" },
        "plan_id": { "$ref": "#/$defs/planId" },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "remediation": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" }
      }
    },
    "branchEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "git_version", "evidence_scope", "remote_overlay_status", "digest"],
      "properties": {
        "algorithm": { "const": "git-candidate-proof-v1" },
        "git_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
        "evidence_scope": { "$ref": "#/$defs/evidenceScope" },
        "remote_overlay_status": {
          "type": "string",
          "enum": ["not-requested", "complete", "incomplete", "stale", "unavailable"]
        },
        "remote_overlay_digest": { "$ref": "#/$defs/digest" },
        "remote_source_identity_sha256": { "$ref": "#/$defs/digest" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "evidence_scope": { "const": "local" } },
            "required": ["evidence_scope"]
          },
          "then": {
            "properties": { "remote_overlay_status": { "const": "not-requested" } },
            "not": { "anyOf": [{ "required": ["remote_overlay_digest"] }, { "required": ["remote_source_identity_sha256"] }] }
          }
        },
        {
          "if": {
            "properties": { "remote_overlay_status": { "const": "complete" } },
            "required": ["remote_overlay_status"]
          },
          "then": { "required": ["remote_overlay_digest", "remote_source_identity_sha256"] }
        },
        {
          "if": {
            "properties": { "evidence_scope": { "const": "remote-aware" } },
            "required": ["evidence_scope"]
          },
          "then": {
            "properties": {
              "remote_overlay_status": {
                "enum": ["complete", "incomplete", "stale", "unavailable"]
              }
            }
          }
        }
      ]
    },
    "remoteOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "status", "observed_at", "refs", "branch_touch_candidates"],
      "properties": {
        "remote": { "type": "string", "minLength": 1 },
        "source_identity_sha256": { "$ref": "#/$defs/digest" },
        "status": { "type": "string", "enum": ["complete", "incomplete", "stale", "unavailable"] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "digest": { "$ref": "#/$defs/digest" },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical_ref", "tip"],
            "properties": {
              "logical_ref": { "$ref": "#/$defs/logicalRef" },
              "tip": { "$ref": "#/$defs/commit" }
            }
          }
        },
        "branch_touch_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/branchCandidateEvidence" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "complete" } },
            "required": ["status"]
          },
          "then": { "required": ["digest", "source_identity_sha256"] }
        }
      ]
    }
  }
}
